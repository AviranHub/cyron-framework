APP_ENV=development
APP_DEBUG=true
APP_NAME=Cyron
APP_URL=http://localhost
APP_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

# Set these values explicitly for production. Never copy development values.
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.example
# APP_KEY=generate-a-random-secret-at-least-32-characters-long

# Request and session hardening
APP_MAX_BODY_SIZE=10485760
APP_SESSION_IDLE_TIMEOUT=1800
APP_SESSION_MAX_LIFETIME=86400
STORAGE_MAX_UPLOAD_SIZE=10
CYRON_ENCRYPTION_KEY=

# Payment gateway (leave sandbox enabled until the public-server test is complete)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_CURRENCY=IRT

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cyron
DB_USERNAME=
DB_PASSWORD=

# Development accounts (used only by the dev:seed command)
DEV_ADMIN_EMAIL=admin@cyron.test
DEV_ADMIN_PASSWORD=change-me-admin
DEV_USER_EMAIL=user@cyron.test
DEV_USER_PASSWORD=change-me-user
